# Test host inventory for tests/distro-test-orchestrator.sh.
#
# Copy to tests/hosts.env (git-ignored) and fill in your own targets.
# Never commit real addresses, hostnames or credentials.
#
#   HOSTS[<name>]   address to ssh to
#   FAMILY[<name>]  "rhel" or "debian" — picks the package manager
#
# The orchestrator connects as $JANITOR_SSH_USER (default: root) using key
# auth only (BatchMode=yes), so set up your keys beforehand.

HOSTS=(
    [rhel-1]="host-1.example.invalid"
    [rhel-2]="host-2.example.invalid"
    [debian-1]="host-3.example.invalid"
    [debian-2]="host-4.example.invalid"
)

FAMILY=(
    [rhel-1]="rhel"
    [rhel-2]="rhel"
    [debian-1]="debian"
    [debian-2]="debian"
)
